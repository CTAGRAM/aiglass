# aiGlass backend settings. Copy to .env (gitignored) or /etc/aiglass.env and fill in.
# Every value has a safe default; with nothing set the server runs on mock providers.
# Keep comments on their own lines: systemd's EnvironmentFile does not strip inline comments.

# --- security ---
# openssl rand -hex 24  — required on every endpoint except /health
API_TOKEN=

# --- storage ---
AIGLASS_DB=aiglass.db

# --- speech-to-text: mock | whisper ---
STT_PROVIDER=mock
WHISPER_MODEL=base

# --- frame captioning: mock | llm (any OpenAI-compatible vision endpoint) ---
VISION_PROVIDER=mock
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

# --- agent ---
# mock | hermes  (push extracted action items to Hermes)
ORCH_PROVIDER=mock
HERMES_URL=http://127.0.0.1:8080
HERMES_API_KEY=
# absolute path in production, e.g. /home/ubuntu/.local/bin/hermes
HERMES_BIN=hermes
HERMES_TIMEOUT=120

# --- people memory (saved people only) ---
# mock | insightface   (insightface needs: pip install insightface onnxruntime opencv-python-headless numpy)
FACE_EMBEDDER=mock
FACE_MODEL=buffalo_s
# minimum cosine similarity for a match
FACE_THRESHOLD=0.5
# optional: higher GitHub API limits when summarising a saved profile link
GITHUB_TOKEN=

# --- MCP tools ---
# web search for aiglass_public_search
TAVILY_API_KEY=
AIGLASS_API_URL=http://127.0.0.1:8000
